<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- NO keychain access here: the extension reads credentials from the
	     0600 mirror file in its own container (CredentialMirror). Touching
	     the login Keychain from the extension surfaced the login-password
	     prompt every few minutes. -->
</dict>
</plist>
