<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Developer ID distribution: the main app is intentionally NOT sandboxed
	     and carries no app-groups entitlement. The shared keychain access group
	     lets the sandboxed widget extension read the credentials it needs to
	     refresh usage without opening the app. -->
	<key>com.apple.security.keychain-access-groups</key>
	<array>
		<string>Y3DAXDSX2F.com.juanlatorre.agent-usage</string>
	</array>
</dict>
</plist>
