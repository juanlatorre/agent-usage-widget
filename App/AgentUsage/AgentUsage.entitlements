<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Developer ID, unsandboxed, hardened runtime. No sandbox/app-groups
	     entitlements (they demanded a provisioning profile or broke sharing).
	     Credentials stay in the login Keychain for the app; the widget gets a
	     0600 mirror inside its own container (CredentialMirror). -->
</dict>
</plist>
